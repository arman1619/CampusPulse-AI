aws_region   = "eu-west-2"
environment  = "demo"
project_name = "campuspulse"

# Leave db_password unset to generate a strong value with the random provider.
# db_password = "set-via-TF_VAR_db_password-not-source-control"

eb_instance_type  = "t3.small"
db_instance_class = "db.t4g.micro"
db_multi_az        = false

# Cost-aware initial deployment: create BLUE first.
# Enable this later for the assessed blue-green deployment demonstration.
enable_blue_green = false

enable_codecommit = true
enable_codebuild  = true

# Optional SNS email subscription. AWS will require email confirmation.
alarm_email = ""

# Do NOT commit a real token here.
# PowerShell: $env:TF_VAR_hf_token = "hf_..."
# hf_token = "hf_..."
