ENVIRONMENT=development
LOG_LEVEL=INFO
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_VALUE_FOR_NON_LOCAL_USE
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
INTERNAL_SERVICE_TOKEN=CHANGE_THIS_INTERNAL_SERVICE_TOKEN
POSTGRES_USER=campuspulse
POSTGRES_PASSWORD=campuspulse_local_only
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
AUTH_DATABASE_URL=postgresql+psycopg://campuspulse:campuspulse_local_only@postgres:5432/campuspulse_auth
FEEDBACK_DATABASE_URL=postgresql+psycopg://campuspulse:campuspulse_local_only@postgres:5432/campuspulse_feedback
NOTIFICATION_DATABASE_URL=postgresql+psycopg://campuspulse:campuspulse_local_only@postgres:5432/campuspulse_notifications
ASSISTANT_DATABASE_URL=postgresql+psycopg://campuspulse:campuspulse_local_only@postgres:5432/campuspulse_assistant
AI_SERVICE_URL=http://ai-service:8003
NOTIFICATION_SERVICE_URL=http://notification-service:8004
CORS_ORIGINS=http://localhost:8080
AI_CONFIDENCE_THRESHOLD=0.75
AI_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
AI_PROVIDER=auto
AI_BACKEND=huggingface
AI_REQUIRE_LLM=true
AI_API_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_MAX_TOKENS=180
AI_TEMPERATURE=0.0
SEED_DEMO=true

# Shared hosted Hugging Face Llama credential. Used by triage + assistant. Keep only in local .env / Jenkins credential / AWS Secrets Manager. Keep HF_TOKEN only in local .env / Jenkins credential / AWS Secrets Manager.
# Free Hugging Face accounts receive limited monthly Inference Providers credits; this is not unlimited free inference.
HF_TOKEN=
ASSISTANT_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
ASSISTANT_PROVIDER=auto
ASSISTANT_BACKEND=huggingface
ASSISTANT_REQUIRE_LLM=true
ASSISTANT_API_TIMEOUT_SECONDS=45
ASSISTANT_MAX_RETRIES=2
ASSISTANT_MAX_NEW_TOKENS=220
ASSISTANT_TEMPERATURE=0.2
ASSISTANT_TOP_P=0.9

AWS_REGION=ap-southeast-2
AWS_ACCOUNT_ID=
ECR_PREFIX=campuspulse
EB_APPLICATION=campuspulse-ai
EB_BLUE_ENV=campuspulse-blue
EB_GREEN_ENV=campuspulse-green
EB_INACTIVE_ENV=
EB_INACTIVE_URL=
PRODUCTION_URL=
EB_ARTIFACT_BUCKET=
RDS_DB_INSTANCE_IDENTIFIER=campuspulse-db
